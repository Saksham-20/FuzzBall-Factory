# /etc/fuzzball/api.env  (root:fuzzball, mode 0640). Secrets: generate with `openssl rand -base64 48`; never reuse a
# value from the test VPS, this repo or a chat. The API refuses to boot with a missing or weak value (api/src/config/env.ts).
NODE_ENV=production
# Same origin as the storefront (nginx serves the API under /api). Comma-separated if there are several.
WEB_ORIGIN=https://__DOMAIN__
API_PUBLIC_URL=https://__DOMAIN__/api
# One proxy hop in front of the API (nginx).
TRUST_PROXY=1
HOST=127.0.0.1
PORT=4100

DATABASE_URL=postgresql://fuzzball:__DB_PASSWORD__@127.0.0.1:5432/fuzzball
# Pool x instances must stay under Postgres max_connections (ops/postgres/fuzzball.conf: 30).
DB_POOL_MAX=10

JWT_ACCESS_SECRET=__GENERATE__
JWT_REFRESH_SECRET=__GENERATE_A_DIFFERENT_ONE__

# `razorpay` = live payments (needs the three Razorpay values, Cloudinary and Resend). `mock` = staging.
PAYMENTS_MODE=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CLOUDINARY_URL=
RESEND_API_KEY=
MAIL_FROM="FuzzBall Factory <hello@__DOMAIN__>"
CONTACT_INBOX_EMAIL=

# First seed only (creates the admin). Remove both lines afterwards.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE comes from the release itself (RELEASE.env).
