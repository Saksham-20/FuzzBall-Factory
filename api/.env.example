# Server
PORT=4000
# REQUIRED, no default: development | test | production. The API refuses to boot without it.
NODE_ENV=development
# Allowed browser origins for CORS (credentials on), comma-separated. The first one is used in email links.
# Cookies are SameSite=Lax, so the web app and API must share a site (localhost:3000 <-> localhost:4000 works).
WEB_ORIGIN=http://localhost:3000

# Database (local Postgres: `createdb fuzzball`)
DATABASE_URL=postgresql://USER@localhost:5432/fuzzball
# e2e tests (`npm run test:e2e`) only run against a database whose name ends in _test (`createdb fuzzball_test`).
TEST_DATABASE_URL=postgresql://USER@localhost:5432/fuzzball_test

# Auth (generate with: openssl rand -base64 48)
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# Seed admin (used only by `npm run seed`)
ADMIN_EMAIL=admin@fuzzball.test
ADMIN_PASSWORD=fuzzball123

# Payments. PAYMENTS_MODE=mock simulates payments ("Test payment" window) and never touches Razorpay, even if keys are set.
# PAYMENTS_MODE=razorpay needs the keys below. Unset: razorpay when both keys are set, else mock. REQUIRED in production.
PAYMENTS_MODE=
# Razorpay (test keys from the Razorpay dashboard)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Uploads: leave CLOUDINARY_URL empty to store files on this machine's disk (UPLOADS_DIR; production needs an absolute path)
CLOUDINARY_URL=
# Public URL of this API (absolute URLs for locally stored uploads). Default: http://localhost:$PORT
API_PUBLIC_URL=
# Local upload directory (default ./uploads)
UPLOADS_DIR=

# Email (Resend). Leave empty in dev to log emails to the console instead.
RESEND_API_KEY=
MAIL_FROM="FuzzBall Factory <hello@fuzzballfactory.example>"
# Where the website contact form delivers (defaults to ADMIN_EMAIL; with neither the form answers 503).
# CONTACT_INBOX_EMAIL=

# Shared with the web app
WHATSAPP_NUMBER=910000000000

# Optional in development, REQUIRED in production (no silent default)
# Reverse-proxy hops to trust for the client IP (rate limiting). 0 = none; 1 behind nginx. Wrong value = every visitor
# shares one rate limit (or IPs can be spoofed).
TRUST_PROXY=0
# Only when web and api are on different subdomains of one site (e.g. .fuzzballfactory.in)
COOKIE_DOMAIN=
ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=30
# Bind address. Defaults to 127.0.0.1 in production and 0.0.0.0 otherwise.
# HOST=
# `Secure` flag on auth cookies. Defaults to true in production, false otherwise. false only for a staging box without
# HTTPS yet (refused together with live payments).
# COOKIE_SECURE=

# Database pool and limits (defaults shown). Keep instances x DB_POOL_MAX under Postgres max_connections.
# DB_IDLE_TX_TIMEOUT_MS must stay above the longest scheduled job (5 minutes).
# DB_POOL_MAX=10
# DB_STATEMENT_TIMEOUT_MS=15000
# DB_IDLE_TX_TIMEOUT_MS=360000

# pino level: fatal|error|warn|info|debug|trace|silent. Default info in production, debug in development, silent in test.
# LOG_LEVEL=info

# Error tracking (Sentry). Unset = off. Use SENTRY_ENVIRONMENT=staging on a production-mode staging box.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=
# SENTRY_RELEASE=
